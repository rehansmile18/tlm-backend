PORT=4200
# This service's OWN database — currently just Schedule.
MONGODB_URI=mongodb://localhost:27017/tlm_backend
# TLM's OWN MongoDB database. Employee, EmployeeGroup, Site, Task, PayPeriodConfig,
# PayrollCalendar, Punch, and EmployeeSiteAssignment all live THERE — this service is their sole
# public CRUD owner, reached via a second Mongoose connection. Point this at the SAME MongoDB
# instance/database TLM's own MONGODB_URI uses.
RULE_REPO_MONGODB_URI=mongodb://localhost:27017/tlm_rule_repository
NODE_ENV=development

# Must be the SAME value as TLM's own JWT_SECRET. This service verifies the identical human-login
# JWTs TLM issues for every role — it does not mint its own. TLM is the single auth authority.
JWT_SECRET=dev-secret-change-me

# TLM's own API — used only for GET /users/me (resolving live role/clientId/siteIds/permissions).
RULE_REPO_BASE_URL=http://localhost:4000/api/v1

# tlm-punch-processor's own API — the internal calculation engine this service calls to trigger
# processing and to proxy Timesheet reads/void. Not reachable by end users directly.
PUNCH_PROCESSOR_BASE_URL=http://localhost:4100/api/v1
# Credentials for a PLATFORM_ADMIN service-account User seeded in TLM (see `npm run seed`) — used
# only for this service's own outbound calls to punch-processor's processing/timesheet endpoints.
# Stored as email/password rather than a pre-minted JWT: this service logs in fresh whenever its
# cached token nears expiry, so nothing here ever needs manual re-minting.
PUNCH_PROCESSOR_SERVICE_ACCOUNT_EMAIL=svc-tlm-backend@internal
PUNCH_PROCESSOR_SERVICE_ACCOUNT_PASSWORD=dev-secret-change-me

# A single shared secret for kiosk/upstream time-clock systems submitting punches.
PUNCH_INGEST_API_KEY=dev-secret-change-me

# How long (ms) a cached TLM GET /users/me lookup is trusted before this service re-checks it.
USER_PROFILE_CACHE_MS=60000

# Comma-separated allowlist of browser origins for CORS. If unset, all origins are allowed
# (fine for local/dev; requests still require a bearer token) — but only when NODE_ENV is
# "development" or "test". Anywhere else, an unset CORS_ORIGIN refuses to boot; set a real list.
# CORS_ORIGIN=https://admin.example.com,https://app.example.com
